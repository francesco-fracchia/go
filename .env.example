# ─── Supabase ──────────────────────────────────────────────────────────
# Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API Keys → service_role
# ⚠️  Questa scavalca TUTTE le regole di sicurezza. Solo lato server, mai
#     con il prefisso NEXT_PUBLIC_, mai in un file che finisce su git.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Percorsi e indirizzi ──────────────────────────────────────────────
# openrouteservice.org — gratis, 2.000 chiamate al giorno
ORS_API_KEY=

# ─── Pagamenti ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Notifiche ─────────────────────────────────────────────────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CONTATTO_EMAIL=ciao@vaigo.app

# ─── SMS e chiamate mascherate ─────────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_MITTENTE=

# ─── Mappa (facoltativa: senza, il pulsante non compare) ───────────────
NEXT_PUBLIC_MAPTILER_KEY=

# ─── Il resto ──────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=https://vaigo.app
CRON_SECRET=
# identificativi degli utenti che possono moderare, separati da virgola
MODERATORI=
